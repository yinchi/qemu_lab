# The initial environment: read once at boot, before the first prompt (`shell::load_environment`).
# Plain NAME=VALUE lines -- not shell syntax: the value is everything after the first "=", literally.
HOME=/root
TZ=America/Toronto
PATH=/bin
# The prompt: `\w` is the working directory (see `shell/prompt.rs`; `\W`, `\$` and `\\` also work), filled in each time.
PS1=\w> 
