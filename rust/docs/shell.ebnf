(* Notation: "-" is set subtraction on characters; otherwise standard EBNF ([ ] optional, ( ) group,
   *, + repetition, | alternation, ?...? a character class too large to spell out). A match is always
   extended as far as it can go before being treated as decided (maximal munch) -- equivalently, of
   two alternatives that could both start matching at the same position, whichever matches more
   wins. *)

(* This grammar describes what the shell accepts, not the diagnostics it gives for what it rejects:
   ";", "&", "(", ")", "<<" and "<&" are excluded from unquoted_start, so they simply fail to match
   anywhere here, the same as any other unparseable leftover -- but the actual parser (lexer.rs)
   recognizes each of these specifically and reports a named "not supported" error for it, rather
   than a generic parse failure. That distinction is an error-reporting choice this grammar doesn't
   represent. *)

char        ::= ? any single character ? ;
whitespace  ::= " " | "\t" | "\v" | "\f" | "\r" | "\n" ;
(* only these six characters separate words; any other character, including other Unicode whitespace
   such as a non-breaking space, is an ordinary word character *)

squote      ::= "'" ;
dquote      ::= "\"" ;
slash       ::= "\\" ;

name        ::= ("A"-"Z" | "a"-"z" | "_") ("A"-"Z" | "a"-"z" | "0"-"9" | "_")* ;
expansion   ::= "${" name "}" | "$?" | "$" name ;
(* Variables and the last status, in an unquoted word and inside double quotes. lexer.rs records each as a
   part of its word; expand.rs gives it a value just before the command runs. A "$" that does not start an
   expansion (followed by a digit, another "$", a blank, the end of the line) is an ordinary character, except
   that "${" not completed as "${" name "}" is refused (a "bad substitution" error, like the other refusals
   below, is an error-reporting choice this grammar does not represent). Neither is recognized inside
   single quotes, nor after a backslash. *)

squote_char ::= char - "'" ;
squoted     ::= squote squote_char* squote ;
(* no escaping inside single quotes *)

dquote_escape    ::= slash (dquote | slash | "$" | "`") ;
(* an escaped character inside double quotes *)
dquote_backslash ::= slash (char - dquote - slash - "$" - "`") ;
(* a bare slash followed by a literal character, excluding the four above *)
dquote_char      ::= expansion | (char - dquote - slash) | dquote_escape | dquote_backslash ;
(* an expansion is tried first, so "$x" is the variable and not the two characters `$` and `x` *)
dquoted          ::= dquote dquote_char* dquote ;

escape        ::= slash char ;
(* outside any quote, "\\" escapes exactly the next character, whatever it is *)

unquoted_start ::= char - whitespace - dquote - squote - slash - "|" - "<" - ">" - "#"
                        - ";" - "&" - "(" - ")" ;
(* non-whitespace characters that can start an unquoted word. Omits characters that have special
meaning in the shell, such as quotes, backslashes, pipes, redirection symbols, and comment
markers. *)
unquoted_tail  ::= unquoted_start | "#" ;
(* "#" may continue a word already started but never starts one *)
unquoted       ::= (expansion | unquoted_start) (expansion | unquoted_tail)* ;
(* likewise, an expansion is tried before the plain character "$" *)

piece       ::= dquoted | squoted | escape ;
(* a quoted or escaped piece of text *)
tail        ::= piece (expansion | unquoted_tail)* ;
(* a tail is a piece followed by zero or more unquoted_tail characters *)
token       ::= unquoted tail* | tail+ ;
(* If the first part of a token is unquoted, it cannot start with # in addition to the other
   special characters *)

comment     ::= "#" char* ;

redir_op     ::= in_redir | out_redir | append_redir | dup_redir ;
in_redir     ::= [ "0" ] "<" ;
out_redir    ::= [ "1" | "2" ] ">" ;
append_redir ::= [ "1" | "2" ] ">>" ;
dup_redir    ::= [ "1" | "2" ] ">&" ;
(* For the dup_redir variant of redir_op, syntax.rs also checks that the following `token` in the
   `segment` is "1" or "2" (as text, once quotes and escapes are resolved) and raises a syntax error
   otherwise. *)

segment     ::= (whitespace | token | redir_op whitespace* token | comment)* ;
(* words and redirections interleave in any order/count; a redirection with no operand ("cmd >"
   at end of input) or two "<"/"&" with nothing valid between them ("<<", "<&") simply fail to
   match anything at that position, leaving input unconsumed -- a syntax error, same as any other
   unparseable leftover. `comment` consumes everything after it, so nothing follows one. A segment
   with neither a token nor a redir_op (blank, or only a comment) is rejected after parsing, not
   excluded here. *)

pipeline    ::= segment ("|" segment)* ;
(* maximal munch ensures a comment consumes everything after it, so it is always part of the last
   segment. *)